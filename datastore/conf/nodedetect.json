[
  {
    "ID": "yamaha_rtx",
    "Name": "Yamaha RTX/NVR Router",
    "Category": "router",
    "Icon": "router",
    "SysObjectIDs": ["yamahaRTX", "rtx1210", "rtx1220", "rtx830", "nvr510", "nvr700w"],
    "SysDescrPattern": "(?i)yamaha.*(rtx|nvr)|rtx\\d+|nvr\\d+",
    "HTTPTitlePattern": "(?i)rtx\\d+|nvr\\d+|yamaha router",
    "VendorPattern": "(?i)yamaha",
    "SensorPollings": [
      {
        "Name": "Yamaha CPU使用率",
        "Type": "snmp",
        "Mode": "get",
        "Params": "yamahaRTCPUUtil5sec.0",
        "Script": "yamahaRTCPUUtil5sec < 90.0",
        "Level": "low",
        "Descr": "YamahaルーターのCPU使用率(5秒平均)"
      },
      {
        "Name": "Yamaha メモリ使用率",
        "Type": "snmp",
        "Mode": "get",
        "Params": "yamahaRTMemoryUtil.0",
        "Script": "yamahaRTMemoryUtil < 90.0",
        "Level": "low",
        "Descr": "Yamahaルーターのメモリ使用率(%)"
      },
      {
        "Name": "Yamaha 内部温度",
        "Type": "snmp",
        "Mode": "get",
        "Params": "yamahaRTFirmwareEnvTemperature.0",
        "Script": "yamahaRTFirmwareEnvTemperature < 55",
        "Level": "low",
        "Descr": "Yamahaルーターの内部温度(℃)"
      }
    ]
  },
