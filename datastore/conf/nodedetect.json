      {
        "Name": "Cisco CPU使用率",
        "Type": "snmp",
        "Mode": "get",
        "Params": "cpmCPUTotal5minRev.1",
        "Script": "cpmCPUTotal5minRev < 90.0",
        "Level": "low",
        "Descr": "Cisco機器のCPU使用率(5分平均)"
      },
      {
        "Name": "Cisco 温度状態",
        "Type": "snmp",
        "Mode": "get",
        "Params": "ciscoEnvMonTemperatureStatusValue.1",
        "Script": "ciscoEnvMonTemperatureStatusValue < 60",
        "Level": "low",
        "Descr": "Cisco機器の温度センサー(℃)"
      },
      {
        "Name": "Cisco ファン状態",
        "Type": "snmp",
        "Mode": "get",
        "Params": "ciscoEnvMonFanState.1",
        "Script": "ciscoEnvMonFanState == 1",
        "Level": "low",
        "Descr": "Cisco機器のファン状態(1: normal)"
      },
      {
        "Name": "Cisco 電源状態",
        "Type": "snmp",
        "Mode": "get",
        "Params": "ciscoEnvMonSupplyState.1",
        "Script": "ciscoEnvMonSupplyState == 1",
        "Level": "low",
        "Descr": "Cisco機器の電源状態(1: normal)"
      }
    ]
  },
